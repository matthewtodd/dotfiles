# vim: set ft=gitconfig :
[alias]
	co = checkout
	pairs = !git config edit --file=$HOME/.config/git/pairs
	st = status
	tidy = !git fetch --prune origin && git branch --format=\"%(refname:short) %(upstream:track)\" | grep \"\\[gone\\]\" | cut -f1 -d \" \" | xargs -I{} git branch -D {}
	up = !git fetch origin && git rebase "origin/$(git symbolic-ref refs/remotes/origin/HEAD | cut -f4 -d/)"
[color]
	ui = auto
[commit]
	gpgsign = true
	verbose = true
[diff]
	algorithm = histogram
	indentHeuristic = true
	submodule = log
[fetch]
	parallel = 0
	prune = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = "~/.config/git/signers"
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[help]
	autocorrect = prompt
[include]
	path = pairs
	path = profile
[init]
	defaultBranch = trunk
[log]
	decorate = short
	follow = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
[rebase]
	autosquash = true
	autostash = true
[stash]
	showIncludeUntracked = true
	showPatch = true
	showStat = false
[status]
	submoduleSummary = true
[submodule]
	recurse = true
[trailer "pair"]
	key = "Co-authored-by: "
	cmd = "test -n \"$1\" && echo \"$(git config pair.$1.name) <$(git config pair.$1.email)>\" || true"
[url "git@github.com:matthewtodd"]
	pushInsteadOf = "https://github.com/matthewtodd"
[user]
	name = "Matthew Todd"
