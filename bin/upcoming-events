#!/usr/bin/env ruby -wU

require 'csv'

class Event
  def self.all
    DATA.map(&:strip).
      map { |line| line.split(' ', 2) }.
      map { |date, emoji| [Date.parse(date), emoji] }.
      map { |date, emoji| new(date, emoji) }
  end

  attr_reader :date

  def initialize(date, emoji)
    @date = date
    @emoji = emoji
  end

  def upcoming?(date = Date.today)
    date <= @date
  end

  def to_s
    @emoji
  end
end

count = ARGV.shift&.to_i || 6

puts Event.all.
  select(&:upcoming?).
  sort_by(&:date).
  take(count).
  join(" ")

__END__
