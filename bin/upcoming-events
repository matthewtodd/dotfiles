#!/usr/bin/env ruby -wU

require 'csv'

class Event
  def self.parse(line)
    date, emoji = line.split(' ', 2)
    new(Date.parse(date), emoji)
  end

  def initialize(date, emoji)
    @date = date
    @emoji = emoji
  end

  def upcoming?(date)
    date <= @date
  end

  def to_s
    @emoji
  end
end

puts DATA.
  map { |line| Event.parse(line.strip) }.
  select { |event| event.upcoming?(Date.today) }.
  take(6).
  join

__END__
