#!/bin/sh

set -euo pipefail

# op account list
export OP_ACCOUNT=F5GN5I4CAZEP7JKCA7BPPBOJX4
# op vault list
# op item list --vault VAULT
export TOKEN="op://mrr75vjcponcnpqbr5yb7pvh4a/q3wzp4fg6kqc6m6izya5rhr77i/token"

QUERY=$(cat << END
  {
    search(query: "type:pr state:open author:@me", type: ISSUE, last: 100) {
      nodes {
        ... on PullRequest {
          id
          title
          url

          commits(last: 1) {
            nodes {
              commit {
                checkSuites(last: 1) {
                  nodes {
                    checkRuns(last: 100, filterBy: {checkType: LATEST}) {
                      nodes {
                        status
                        name
                        detailsUrl
                        conclusion
                      }
                    }
                  }
                }
                status {
                  state
                  contexts {
                    state
                    targetUrl
                    context
                  }
                }
              }
            }
          }


          reviews(last: 100) {
            nodes {
              state
              url
              author {
                ... on User {
                  name
                }
                login
              }
              updatedAt
            }
          }

        }
      }
    }
  }
END
)

op run --no-masking -- \
  curl https://api.github.com/graphql \
    --variable "%TOKEN" \
    --expand-header "Authorization: bearer {{TOKEN}}" \
    --header "Content-Type: application/json" \
    --data "$(jq -n --arg query "${QUERY}" '{ "query": $query }')" \
    --silent | \
    jq '.data.search.nodes'
