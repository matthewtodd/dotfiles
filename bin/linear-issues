#!/bin/sh

# Create a Personal API key in Linear -> Settings -> Security & access.
# Save it in 1Password as an API Key, and add a new text field called "user_id"
# with my Linear user id.

# op account list
export OP_ACCOUNT=LACFAVAH2JBCJMTHKPL343HZWY

# op vault list
VAULT=vhjvaw3l2mywmrexoj7g2optvq

# op item list --vault VAULT
ITEM=nub4h4ads5nzg7sqainxsngy5u

export LINEAR_API_KEY="op://${VAULT}/${ITEM}/credential"
export LINEAR_USER_ID="op://${VAULT}/${ITEM}/user_id"

QUERY=$(cat << END
  query {
    user(id: "{{LINEAR_USER_ID}}") {
      assignedIssues(
        filter: { state: { name: { eq: "In Progress" } } },
        first: 200
      ) {
        nodes { identifier title url }
      }
    }
  }
END
)

op run --no-masking -- \
  curl https://api.linear.app/graphql \
    --variable "%LINEAR_API_KEY" \
    --variable "%LINEAR_USER_ID" \
    --expand-header "Authorization: {{LINEAR_API_KEY}}" \
    --header "Content-Type: application/json" \
    --expand-data "$(jq -n --arg query "${QUERY}" '{ "query": $query }')"\
    --silent | \
    jq '.data.user.assignedIssues.nodes'
