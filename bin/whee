#!/bin/sh

set -euo pipefail

calendar() {
  d=$(date -jur "${1}" +"%A, %B %d, %Y at %l:%M:%S %p")
  osascript -e "tell application \"Calendar\" to view calendar at date \"${d}\""
}

mode="m"
n=$(date -ju +%s)
e=1802702660

while getopts "dDwmyaAn:e:" opt; do
  case ${opt} in
    n) n=$(date -ju -f "%Y%m%d-%H%M%S" "${OPTARG}-000000" +%s) ;;
    e) e=$(date -ju -f "%Y%m%d-%H%M%S" "${OPTARG}-000000" +%s) ;;
    *) mode=${opt} ;;
  esac
done

h=0

hl=(
  1788739200
  1794182400 1794268800 1794355200 1794441600 1794528000
  1795651200 1795737600
  1797811200 1797897600 1797984000 1798070400 1798156800
  1798416000 1798502400 1798588800 1798675200 1798761600
)

for d in "${hl[@]}"; do
  (( n < d && d < e && h++ ))
done

case ${mode} in
  d) bc -e "scale=0; (${e} - ${n}) / 86400" ;;
  D) bc -e "scale=0; (${e} - ${n}) / 120960 - ${h}" ;;
  w) bc -e "scale=1; (${e} - ${n}) / 604800" ;;
  m) bc -e "scale=2; (${e} - ${n}) / 2628000" ;;
  y) bc -e "scale=3; (${e} - ${n}) / 31536000" ;;

  a) date -jr $(bc -e "2 * ${n} - ${e}") ;;
  A) calendar $(bc -e "2 * ${n} - ${e}") ;;
esac
